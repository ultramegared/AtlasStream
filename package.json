{
  "name": "atlasstream",
  "version": "1.0.0",
  "private": true,
  "description": "AtlasStream - Streaming platform for TV, Mobile and Web.",
  "author": "ultramegared",
  "license": "UNLICENSED",
  "workspaces": [
    "apps/*",
    "packages/*",
    "backend"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "format": "prettier --write .",
    "clean": "turbo clean",
    "verify": "npm run lint && npm run typecheck && npm test"
  },
  "devDependencies": {
    "prettier": "^3.6.0",
    "turbo": "^2.5.0",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@11"
}